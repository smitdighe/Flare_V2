# ============================================================
# Flare_V2 — single project-wide ignore file.
# Root-only by design: one place to look, no per-package drift.
# Paths are anchored (backend/..., frontend/...) so a rule for one
# package can never silently swallow a same-named path in the other.
# ============================================================

# ---------------- Secrets ----------------
# .env.example IS committed — it is the contract for what must be set.
.env
.env.*
!.env.example
backend/.env
frontend/.env

# ---------------- OS / editor cruft ----------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
!.vscode/extensions.json

# ============================================================
# BACKEND (Python / FastAPI)
# ============================================================

# Bytecode + build metadata
backend/**/__pycache__/
backend/**/*.py[cod]
backend/*.egg-info/
backend/flare_backend.egg-info/
backend/.eggs/
backend/dist/

# Virtualenv
backend/.venv/
backend/venv/

# Tool caches
backend/.pytest_cache/
backend/.ruff_cache/
backend/.mypy_cache/
backend/.coverage
backend/.coverage.*
backend/htmlcov/
backend/coverage.xml

# SQLite runtime DB (regenerated by alembic + seed)
backend/*.db
backend/*.db-wal
backend/*.db-shm

# Phase 7 CI output. `scripts.ci.run label_leak` writes the prompt corpus here
# and CI uploads it as a build artifact; it is EVIDENCE FOR ONE RUN, generated
# fresh every time, so committing it would pin a stale dump beside a live check.
backend/build/

# Regenerable from GeneratedLabelledFlows.zip, and far too large to commit.
backend/data/datasets/raw/
backend/data/datasets/cicids2017/
backend/data/datasets/clean/
!backend/data/splits/
!backend/data/PROVENANCE.md

# backend/models/ is deliberately NOT ignored — D21. The committed weights and
# index are the reason a cold clone works with no network, which is the failure
# that a lazily-downloaded model causes on demo day.

# ============================================================
# FRONTEND (Vite / React / Playwright)
# ============================================================

frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.local

# Playwright: report/results/browser cache are all regenerated per run.
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/
frontend/playwright/.cache/

# npm/yarn/pnpm debug output (lockfile itself IS committed)
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# ---------------- Catch-all logs ----------------
*.log


BACKEND_SUMMARY.md
CONTRACT.md
GAPS.md
PLAN.md 
REAL_VS_SIMULATED.md 