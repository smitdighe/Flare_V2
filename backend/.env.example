# Flare Backend v2 - configuration
# Copy to .env and fill in. Every variable below is read by real code
# (PLAN §14: no dead flags).

# ---------------------------------------------------------------------------
# REQUIRED. No default, no fallback - the app refuses to start without it
# (PLAN §9, fail closed). Minimum 32 characters.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# Optional - defaults shown. Uncomment only to override.
# ---------------------------------------------------------------------------

# Signing algorithm. HS256 is the only accepted value.
# JWT_ALGORITHM=HS256

# The login panel renders "jwt · 30m access" (flare/AuthPanel.jsx:292).
# PLAN §3.1 requires that claim to be literally true - change with care.
# ACCESS_TOKEN_TTL_MINUTES=30
# REFRESH_TOKEN_TTL_DAYS=7

# Async SQLAlchemy + aiosqlite. WAL is enabled at connect time (PLAN D1, T10).
# DATABASE_URL=sqlite+aiosqlite:///./flare.db

# dev | test | prod. `prod` disables /docs.
# ENVIRONMENT=dev

# Closed by default (PLAN §9). The frozen frontend dev server runs on 5174.
# "*" together with CORS_ALLOW_CREDENTIALS=true is rejected at startup.
# CORS_ORIGINS=["http://localhost:5174"]
# CORS_ALLOW_CREDENTIALS=false

# Inbound limiter. Returns a real 429 as a JSONResponse, never a 500
# (PLAN §9). CORS is registered last so the 429 still carries CORS headers.
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60

# Cheap /health serves locally cached provider state and NEVER calls a
# provider. Results are served for TTL seconds; past STALE seconds they are
# refreshed from local state on the next request (CONTRACT §9.5).
# The real four-provider probe is /health/deep, arriving in Phase 3.
# HEALTH_CACHE_TTL_SECONDS=60
# HEALTH_CACHE_STALE_SECONDS=120

# admin@flare.dev / admin123 exists ONLY when this is true (CONTRACT §8.7).
# On a default boot that account does not exist and the frontend's
# "Quick demo sign in" button returns 401. That is intended.
# Never enable outside a demo.
# DEMO_SEED_ENABLED=false

# DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PHASE 4 — product surface. Every value below has a working default; they are
# listed so the knobs are discoverable, not because anything needs setting.
# ---------------------------------------------------------------------------

# CONTRACT §9.5 — a SECOND, per-user budget on /health/deep only. The global
# limiter above allows 120/min, which is right for reading alerts and wrong for
# a route that spends four metered provider quotas per call: at that rate one
# operator holding Refresh draws 480 provider calls a minute.
# HEALTH_DEEP_CALLS_PER_MINUTE=4

# PLAN §9 — bounds on the regex a `contains` rule condition compiles from
# user-typed text. The first two are checked when the rule is CREATED; the last
# two on every match. `regex` is used rather than `re` because only it can
# enforce a match deadline — a catastrophic backtrack in `re` cannot be
# interrupted, and would stall the whole API until it finished.
# RULE_REGEX_MAX_LENGTH=200
# RULE_REGEX_MAX_QUANTIFIERS=8
# RULE_REGEX_MATCH_TIMEOUT_SECONDS=0.05
# RULE_REGEX_MAX_SUBJECT_LENGTH=1024

# The frozen export button always sends limit=500; this caps it server-side.
# EXPORT_MAX_ROWS=500

# PLAN §3.1 — threat clusters, with a REAL threshold, served from the DB.
# CORRELATION_MIN_ALERTS=3
# CORRELATION_WINDOW_MINUTES=1440

# CONTRACT §9.4 / PLAN D7 — one-minute buckets over a 30-minute window, so a
# bucket count IS alerts-per-minute and `alert_velocity` (the mean over the
# window) needs no rescaling. The number has to match the label it renders
# under.
# STATS_WINDOW_MINUTES=30
# STATS_BUCKET_SECONDS=60

# Right rail. Signal velocity is a SAMPLED series: the scheduler records one
# observation per interval and the panel plots those samples. The forecast is
# the window-over-window delta of PLAN D8.
# METRICS_SAMPLE_INTERVAL_SECONDS=60
# METRICS_SAMPLE_WINDOW_MINUTES=60
# FORECAST_WINDOW_MINUTES=30
# PIPELINE_ACTIVITY_SAMPLE_SIZE=200

# PLAN §4.1 — APScheduler. Both jobs persist what they compute and both are
# read; turning the scheduler off leaves the Threat Clusters screen serving
# whatever the last run stored, which is the honest consequence.
# SCHEDULER_ENABLED=true
# CORRELATION_REFRESH_SECONDS=120

# A playbook whose alert_type and severity_threshold match an incoming alert
# executes automatically. PLAN D27 governs the comparison: `unknown` sits
# outside the severity order and satisfies no threshold, ever, so an alert
# whose classification FAILED never auto-triggers a response.
# PLAYBOOK_AUTOTRIGGER_ENABLED=true

# ---------------------------------------------------------------------------
# PHASE 5 — presence-aware notifications. PLAN §8, D11, D12.
# ---------------------------------------------------------------------------

# OFF by default. A build with no SMTP credentials starts and runs normally.
# Turned ON, PLAN §8.4's fail-closed rule applies: startup REFUSES without
# SMTP_HOST and SMTP_FROM, and refuses a username without a password.
# NOTIFICATIONS_ENABLED=false

# PLAN §8.2 — how long a connection's last frame stays evidence that someone is
# watching. The frozen frontend sends a presence frame on connect and on every
# visibilitychange, and nothing periodic, so an analyst reading without
# switching tabs emits no frames at all. Fifteen minutes covers an unbroken
# reading session; anything shorter would email that analyst about an alert on
# the screen in front of them. The socket closing is the PRIMARY away signal —
# this is the backstop for a connection that neither closes nor speaks.
# PRESENCE_STALE_SECONDS=900

# Which severities notify. `unknown` is REFUSED here, not merely absent: PLAN
# D27 puts it outside the severity order because it means classification
# FAILED, and emailing about the pipeline's own failure is the fail-open the
# ordering exists to prevent.
# NOTIFY_SEVERITIES=["critical","high"]

# One email per user per event type per window, carrying a rollup count. The
# FIRST alert in a window sends immediately; the rest are held and roll up.
# NOTIFICATION_DEBOUNCE_SECONDS=300
# NOTIFICATION_DIGEST_THRESHOLD=3
# NOTIFICATION_DIGEST_MAX_ALERTS=10
# NOTIFICATION_PENDING_MAX=200
# NOTIFICATION_FLUSH_SECONDS=60

# Bounded retry, and only on TRANSIENT failures. A permanent SMTP rejection
# (5xx: bad mailbox, blocked sender) is not retried — it would reproduce the
# same rejection and burn the same quota.
# NOTIFICATION_MAX_ATTEMPTS=3
# NOTIFICATION_RETRY_BACKOFF_SECONDS=2

# Hand-off from the replay loop. Bounded and non-blocking, so an SMTP host that
# accepts a connection and then answers nothing cannot stall the alert feed.
# NOTIFICATION_QUEUE_SIZE=500

# PLAN §8.4 — SMTP. Required when NOTIFICATIONS_ENABLED=true.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_START_TLS=true, and an
# APP PASSWORD (not the account password) as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_FROM_NAME=Flare SOC
# SMTP_USE_TLS (implicit TLS, port 465) and SMTP_START_TLS (STARTTLS, port 587)
# are mutually exclusive and startup rejects both being true.
# SMTP_USE_TLS=false
# SMTP_START_TLS=true
# THE POINT OF THE REWRITE: the prior build used blocking smtplib with no
# timeout and hung a worker forever on a black-holed host.
# SMTP_TIMEOUT_SECONDS=15

# Where the email's single link points. No tracking pixel, no external asset.
# DASHBOARD_BASE_URL=http://localhost:5174

# ---------------------------------------------------------------------------
# PHASE 6 — the eval. PLAN §7.
# ---------------------------------------------------------------------------

# PLAN E6 — CAPPED. An uncapped run over the 1,800-row eval partition is
# hundreds of live provider calls and near-certain rate limiting.
#
# 300, NOT 80, and the reason is arithmetic rather than the score (PLAN §7.3f):
# accuracy over n rows moves in steps of 1/n, and 1/80 = 0.0125 cannot express
# the 0.995 ceiling threshold at all — so `lightgbm_absolute` and `degenerate`
# could only ever report INCONCLUSIVE on the sample. 1/300 = 0.0033 expresses
# every threshold in §7.3, and at the partition's measured 0.9944 a 300-row
# sample expects ~1.7 errors, so the confusion matrix carries real off-diagonal
# mass instead of being empty by construction. The n=80 run is kept and
# published beside it in data/eval/n80.json.
# EVAL_SAMPLE_SIZE=300

# PLAN E5 — threaded through sampling and shuffling. The LLM tier is still not
# deterministic (provider temperature, server-side variance); that is disclosed
# in the run notice rather than pretended away.
# EVAL_SEED=20260904

# Pacing between LLM-tier calls. Groq's free tier for the classify model is
# ~30 RPM; 2s keeps an 80-row run inside it without relying on key rotation to
# absorb a burst.
# EVAL_LLM_PACE_SECONDS=2

# Turning this off leaves the degenerate and absolute-ceiling guards
# INCONCLUSIVE, because the capped sample cannot resolve them.
# EVAL_SCORE_FULL_PARTITION=true

# ===========================================================================
# PROVIDERS — the key pool, the model IDs and the timeouts (PLAN D26/D31/§10.3)
# ===========================================================================
#
# **A PROVIDER ENABLED WITH AN EMPTY POOL FAILS CLOSED AT STARTUP.** That is
# deliberate (§10.3): discovering a missing key on the first alert means
# discovering it in front of an audience. To run with no keys at all, set
# OFFLINE_MODE=true — the DECLARED way to run without them, visible in the
# trace, on /health and in the UI.

# PLAN E9 / §10.3 — no provider is called, every alert is marked degraded, and
# its trace names `offline` as the provider. Never a silent template answer.
# OFFLINE_MODE=false

# ---------------------------------------------------------------------------
# The key pool: THREE keys per provider, with declared purposes (D26).
#
# Free tiers are metered PER KEY, so three keys turn one hard cap into three
# sequential windows. Selection is STICKY, not round-robin: one key is used
# until it 429s, then the pool advances — round-robin would spend all three
# quotas in parallel and arrive at the same wall at the same time.
#
#   dev       burnt during development and rehearsal
#   reserved  untouched until demo day
#   spare     the third window
#
# PLAN D39 — a 429 COOLS a key and it returns on its own; a hard auth rejection
# (403 project-denied, 401, or a 400 carrying an explicit invalid-key marker)
# removes it for the process lifetime and only a new credential brings it back.
# /health/deep reports the two states separately.
# ---------------------------------------------------------------------------
GROQ_API_KEY_DEV=
GROQ_API_KEY_RESERVED=
GROQ_API_KEY_SPARE=

GEMINI_API_KEY_DEV=
GEMINI_API_KEY_RESERVED=
GEMINI_API_KEY_SPARE=

# Seconds a 429'd key is left cooling when the provider sends no `Retry-After`.
# The provider's own header is honoured when present.
# KEY_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# Model IDs — VERIFIED BY LIVE CALL, not read from docs (D31 / T3).
#
# `gemini-2.5-flash` is LISTED by the models endpoint and 404s on
# generateContent: "no longer available to new users". A listing proves a name
# exists, not that a key can call it. Re-verify with
# `python -m scripts.verify_models` before each rehearsal.
# ---------------------------------------------------------------------------
# GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
# GROQ_MODEL_FALLBACK=qwen/qwen3.8-27b

# D29 — GPT OSS models are reasoning models and have returned HTTP 200 with an
# EMPTY `content` when reasoning went to a separate channel. `hidden` routes the
# final answer back into `content`. Set explicitly rather than trusted.
# GROQ_REASONING_FORMAT=hidden
# GROQ_REASONING_EFFORT=low

# GEMINI_MODEL=gemini-3.6-flash

# D30 — THE THINKING LEVEL AND THE TIMEOUT ARE ONE SETTING IN TWO FIELDS, and
# config enforces the pairing. Measured at `low`: 3.1-5.0s median with a 20.6s
# tail, so a 12s ceiling would fail roughly one call in eight. 25s covers it.
# GEMINI_THINKING_LEVEL=low
# LLM_TIMEOUT_SECONDS_GEMINI=25
# LLM_TIMEOUT_SECONDS_GROQ=30

# ===========================================================================
# THREAT INTEL (PLAN §10.1 / D32)
# ===========================================================================
#
# Absent keys are an honest traced SKIP, not a fabricated clean verdict: a
# failed lookup has NO score, because defaulting it to 0 renders "we could not
# check" as "we checked and it is fine".
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# INTEL_TIMEOUT_SECONDS=8

# Per-IP cache. A DEGRADED verdict is never cached (T12), so a transient outage
# cannot be pinned for the whole TTL.
# INTEL_CACHE_TTL_SECONDS=900
# INTEL_CACHE_MAX_ENTRIES=2048

# Reputation at or above this forces `high` (§7.3c). Intel beats the model and
# loses to a rule.
# INTEL_ESCALATION_SCORE=50

# ===========================================================================
# TIERING AND THE GRAPH (PLAN D18/D19/§7.3c)
# ===========================================================================

# THE CLASSIFICATION GATE. Below this confidence the alert escalates to the LLM.
# Set empirically from the validation split in Phase 2a, not guessed. Isotonic
# calibration on a well-separated problem pushes 99.7% of predictions to exactly
# 1.0, so at 0.99 this fires on roughly THREE ALERTS PER THOUSAND — which is the
# gate being confident, not the gate being broken (§7.3 Band 3).
# ESCALATION_CONFIDENCE_THRESHOLD=0.99

# THE REASONING GATE — a SEPARATE gate, and NOT rare. Every alert at or above
# this severity gets an LLM narrative regardless of classification confidence.
# `unknown` is outside the severity order and satisfies no threshold, ever
# (D27): treating a failed classification as high would fire playbooks and
# emails on the pipeline's own failures.
# REASON_SEVERITY_FLOOR=high

# The CAP, which is a different question from the floor above. The floor is
# policy — which alerts deserve a narrative; this is what the free tier can
# absorb. Every alert turned away gets a TRACED skip naming the budget, never a
# silent drop.
# REASON_CALLS_PER_MINUTE=10

# Wall-clock ceiling for one alert through the whole graph. On expiry the state
# is returned PARTIAL with a traced failure, never held open.
# GRAPH_BUDGET_SECONDS=45

# Bounded concurrency. Past this an alert waits rather than the process growing.
# MAX_CONCURRENT_PIPELINES=8

# ===========================================================================
# RETRIEVAL (PLAN D3/D4)
# ===========================================================================

# RETRIEVAL_TOP_K=5

# Below this cosine score the retrieval is reported as low-confidence and the
# reason node is told so, rather than being handed a weak match as if it were a
# strong one. Grounding still applies: a technique ID the model names but the
# retriever did not return is DROPPED.
# RETRIEVAL_LOW_CONFIDENCE_SCORE=0.45

# ===========================================================================
# REPLAY (PLAN D10/D23)
# ===========================================================================

# The demo cadence. 30/min at a `high` reasoning floor admits ~20/min, which is
# why REASON_CALLS_PER_MINUTE exists.
# REPLAY_ALERTS_PER_MINUTE=30

# Start the replay loop with the app. The test suite pins this false so a
# background task cannot race per-test truncation.
# REPLAY_AUTOSTART=true

# ===========================================================================
# LIVE STAGED-ATTACK INJECTION (PLAN D23, §4.4a, Phase 4a)
# ===========================================================================
#
# The demo's live segment: a teammate runs real attacks against a target box on
# a network we bring ourselves, Suricata watches it, and `tools/eve_forwarder.py`
# tails its eve.json into POST /api/v1/ingest/eve.
#
# OFF BY DEFAULT, and off means the route is NOT MOUNTED — not mounted and
# refusing. With this false there is nothing to reach. Replay runs identically
# either way (PLAN I19).
# LIVE_INGEST_ENABLED=false

# The forwarder's credential. A DEDICATED SERVICE TOKEN, never a user JWT: the
# forwarder runs unattended on the machine being attacked, and a user token
# would put that account's whole authority there. 32 characters minimum, and
# LIVE_INGEST_ENABLED=true without it REFUSES TO START.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# INGEST_SERVICE_TOKEN=

# This route's OWN budget, separate from RATE_LIMIT_REQUESTS. The forwarder
# batches, so a few POSTs a second is generous; more than this is a
# misconfigured tail loop or somebody else.
# INGEST_REQUESTS_PER_MINUTE=60
# INGEST_BURST=10

# Payload cap, checked from Content-Length BEFORE the body is read.
# INGEST_MAX_BODY_BYTES=1048576

# Per-batch event cap, checked after parsing. Bounds the work one accepted
# request can create on the live lane.
# INGEST_MAX_EVENTS_PER_BATCH=200
